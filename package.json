{
  "name": "organon",
  "version": "6.23.18",
  "description": "Organon - App desktop local com Electron",
  "main": "dist/main/index.js",
  "author": "Pedro Reoli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroReoli/Organon.git"
  },
  "homepage": "https://github.com/PedroReoli/Organon#readme",
  "bugs": {
    "url": "https://github.com/PedroReoli/Organon/issues"
  },
  "files": [
    "bin/",
    "dist/main/",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "organon": "./bin/organon.cjs"
  },
  "scripts": {
    "cli": "node bin/organon.cjs",
    "ops": "node scripts/ops-menu.cjs",
    "dev": "node scripts/dev-app.cjs",
    "full": "node scripts/dev-app.cjs",
    "dev:direct": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "node scripts/clean-dist.cjs && tsc -p tsconfig.node.json && electron .",
    "build": "node scripts/clean-dist.cjs && tsc -p tsconfig.node.json && vite build && node scripts/validate-build-output.cjs && node scripts/check-bundle-budget.cjs",
    "optimize:images": "node scripts/optimize-images.cjs",
    "build:electron": "npm run build && electron-builder",
    "build:full": "npm run build:electron",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "typecheck:node": "tsc -p tsconfig.node.json --pretty false",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "test": "npm run typecheck && npm run release:validate && npm run test:storage:v2 && npm run test:storage:baseline && electron scripts/validate-activity-feed.cjs && npm run test:whisper:installer && npm run test:whisper:transcription && npm run test:mcp && npm run test:mcp:search && electron scripts/validate-coherence.cjs",
    "test:coherence": "npm run build && electron scripts/validate-coherence.cjs",
    "test:storage:v2": "npm run build && electron scripts/validate-storage-v2.cjs && node scripts/validate-cli-storage.cjs",
    "test:storage:baseline": "npm run typecheck:node && node scripts/validate-storage-baselines.cjs",
    "test:activity-feed": "npm run build && electron scripts/validate-activity-feed.cjs",
    "benchmark:storage": "npm run typecheck:node && node scripts/benchmark-storage.cjs",
    "release:validate": "node scripts/validate-release-policy.cjs",
    "test:mcp": "node scripts/validate-mcp.cjs",
    "test:mcp:search": "node scripts/validate-mcp-search.cjs",
    "prepack": "npm run build",
    "bump": "node scripts/bump-version.js",
    "bump:v": "node scripts/bump-version.js --version",
    "install:all": "node scripts/install-all.cjs",
    "exec": "node scripts/bump-version.js && set CSC_IDENTITY_AUTO_DISCOVERY=false && npm run build && electron-builder --win --publish never",
    "exec:manual": "set CSC_IDENTITY_AUTO_DISCOVERY=false && npm run build && electron-builder --win --publish never",
    "exec:1": "node scripts/release-and-install.cjs",
    "preview": "vite preview",
    "setup:api": "echo 'Configura token via Settings > API e Sincronização'",
    "setup:whisper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-whisper.ps1",
    "test:whisper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-whisper-validation.ps1 && electron scripts/validate-whisper.cjs",
    "test:whisper:installer": "electron scripts/validate-whisper-model-installer.cjs",
    "test:whisper:transcription": "electron scripts/validate-whisper-transcription.cjs",
    "test:meeting:recording": "npm run typecheck:node && electron scripts/validate-meeting-recording.cjs",
    "test:meeting:diarization": "npm run typecheck:node && electron scripts/validate-meeting-diarization.cjs",
    "test:meeting:providers": "npm run typecheck:node && node scripts/validate-meeting-provider-gateway.cjs"
  },
  "keywords": [
    "electron",
    "organizer",
    "weekly-planner",
    "drag-and-drop"
  ],
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "electron": "^41.10.6",
    "electron-builder": "^26.7.0",
    "postcss": "^8.4.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/heatmap": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-subscript": "^3.31.3",
    "@tiptap/extension-superscript": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-typography": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "electron-updater": "^6.8.9",
    "jspdf": "^4.2.1",
    "lucide-react": "1.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1",
    "tippy.js": "^6.3.7"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.18"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    }
  }
}
