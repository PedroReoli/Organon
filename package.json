{
  "name": "organon",
  "version": "6.23.2",
  "description": "Organon - App desktop local com Electron",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node ../../scripts/dev/dev-app.js",
    "full": "node ../../scripts/dev/dev-app.js",
    "dev:direct": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "cell": "npm --prefix mobile run start",
    "build:mobile": "npm --prefix mobile run build:preview",
    "build:mobile:prod": "npm --prefix mobile run build:production",
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.node.json && electron .",
    "build": "tsc -p tsconfig.node.json && vite build",
    "build:electron": "npm run build && electron-builder",
    "build:python": "node ../../scripts/build/build-python.js",
    "build:full": "npm run build:python && npm run build:electron",
    "test:storage:v2": "npm run build && electron scripts/validate-storage-v2.cjs",
    "bump": "node ../../scripts/build/bump-version.js",
    "bump:v": "node ../../scripts/build/bump-version.js --version",
    "exec": "node ../../scripts/build/bump-version.js && set CSC_IDENTITY_AUTO_DISCOVERY=false && npm run build && electron-builder --win --publish never",
    "exec:manual": "set CSC_IDENTITY_AUTO_DISCOVERY=false && npm run build && electron-builder --win --publish never",
    "exec:1": "npm run exec && powershell -NoProfile -ExecutionPolicy Bypass -Command \"$release = Join-Path (Resolve-Path '../..') 'release'; $installer = Get-ChildItem -Path $release -Filter '*Setup*.exe' -Recurse -File | Sort-Object LastWriteTime -Descending | Select-Object -First 1; if (-not $installer) { throw 'Instalador .exe não encontrado em release/' }; Write-Host ('Iniciando instalador: ' + $installer.FullName); Start-Process -FilePath $installer.FullName -Wait\"",
    "preview": "vite preview",
    "setup:api": "echo 'Configura token via Settings > API e Sincronização'",
    "release": "node ../../scripts/ops/release-app.js",
    "manager": "npm --prefix manager run dev",
    "build:manager": "npm --prefix manager run build:electron",
    "setup:whisper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-whisper.ps1",
    "test:whisper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-whisper-validation.ps1 && electron scripts/validate-whisper.cjs"
  },
  "keywords": [
    "electron",
    "organizer",
    "weekly-planner",
    "drag-and-drop"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "electron": "^28.3.3",
    "electron-builder": "^26.7.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.0",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/heatmap": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.1.13",
    "@tiptap/extension-subscript": "^2.27.2",
    "@tiptap/extension-superscript": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-typography": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/react": "^2.1.13",
    "@tiptap/starter-kit": "^2.1.13",
    "@tiptap/suggestion": "^2.27.2",
    "electron-updater": "^6.8.9",
    "form-data": "^4.0.5",
    "jspdf": "^4.2.1",
    "lucide-react": "1.14.0",
    "node-vibrant": "^4.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1",
    "tippy.js": "^6.3.7",
    "uuid": "^9.0.1"
  }
}
